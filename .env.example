# FINN configuration. Copy this file to .env (gitignored) and FINN loads it automatically;
# real environment variables override it. Every variable is optional: with none set, FINN runs on the labelled demo dataset
# and every LLM feature uses its deterministic fallback.

# --- Language model (Google Gemini free tier, OpenAI-compatible endpoint)
GEMINI_API_KEY=            # also read from GOOGLE_API_KEY or LLM_API_KEY
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_FAST_MODEL=          # override auto-resolved Flash-Lite (bulk extraction)
# LLM_STRONG_MODEL=        # override auto-resolved Flash (synthesis only)
# LLM_TIMEOUT_S=60
# LLM_MIN_INTERVAL_S=4.5   # keeps under the free tier's ~10-15 requests/minute

# --- Storage
# FINN_DATA_DIR=backend/data          # SQLite DB, LLM cache and downloaded PDFs
# DATABASE_URL=sqlite:///backend/data/finn.db   # Postgres also works: postgresql+psycopg://...
# FINN_SNAPSHOT_DIR=backend/seed      # prebuilt demo snapshot restored on first start

# --- Retrieval
# FINN_ENABLE_DENSE=0                 # 1 = add fastembed (ONNX) dense retrieval; pip install fastembed
# FINN_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Web
# CORS_ORIGINS=*
# FRONTEND_DIST=frontend/dist
# PORT=8000

# --- Deploy (run.sh deploy prompts for these; they are never written to disk)
# RENDER_API_KEY=
# RENDER_API=https://api.render.com/v1
# REPO_NAME=finn
