{
  "compilerOptions": {
    "target": "ES2021", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "isolatedModules": true, "allowImportingTsExtensions": false, "types": ["vite/client"]
  },
  "include": ["src"]
}
