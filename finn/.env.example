# --- LLM (optional; FINN runs fully deterministic without it) ---
# Google Gemini, free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   (default; any OpenAI-compatible endpoint works)
# Model IDs are auto-picked (newest Flash-Lite = fast tier, newest Flash = strong tier). Pin them if you prefer:
# LLM_FAST_MODEL=gemini-3.5-flash-lite
# LLM_STRONG_MODEL=gemini-3.8-flash
# LLM_MIN_INTERVAL_S=4.5     # spacing between calls, keeps under free-tier requests/minute

# --- storage ---
# DATABASE_URL=sqlite:///./data/finn.db        (default)
# FINN_DATA_DIR=./data

# --- retrieval ---
# FINN_ENABLE_DENSE=1                          (needs `pip install fastembed`; BM25 always on)
# FINN_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- web ---
# CORS_ORIGINS=*                               (comma-separated)
# FRONTEND_DIST=../frontend/dist               (FastAPI serves the built SPA from here)
# VITE_API_URL=                                (frontend only, if the API lives on another origin)
